# Copiar a .env y ajustar si hace falta.

# Cuando corre vía docker-compose, "postgres" es el nombre del servicio (host).
# Para correr el binario suelto en tu máquina (fuera de Docker), usa localhost:5432.
DATABASE_URL=postgres://cartagena:cartagena_dev@postgres:5432/cartagena?sslmode=disable

PORT=8080

# Compartida con cartagena-guide (.env, ADMIN_API_KEY) — la exige el header
# X-Admin-Key en /api/admin/*. Sin sistema de usuarios todavía (Fase 3).
ADMIN_API_KEY=dev-admin-key-change-me

# Firma los JWT de sesión de usuario (Fase 4) — sistema separado del admin de arriba.
JWT_SECRET=dev-jwt-secret-change-me
